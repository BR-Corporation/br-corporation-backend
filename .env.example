PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
ADDITIONAL_ORIGINS=
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password

# --- Brevo (transactional email — preferred over Gmail on prod) ---
# Best: use the HTTPS API (port 443, never blocked). Get from Brevo → SMTP & API → API Keys.
BREVO_API_KEY=
# Alternatively: SMTP (port 587, often blocked on cloud hosts like Render).
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
# Sender address the recipient sees. Must be a verified sender on your Brevo account
# (your signup email is auto-verified). Falls back to EMAIL_USER if not set.
EMAIL_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Twilio SMS ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# --- MSG91 SMS OTP (alternate) ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_DEFAULT_COUNTRY=91

SMS_DEFAULT_COUNTRY=91
